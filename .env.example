CLOUDINARY_CLOUD_NAME=cloudinary cloud name
CLOUDINARY_API_KEY=cloudinary api key
CLOUDINARY_API_SECRET=cloudinary api secret
SMTP_USER=user email for SMTP_USER
SMTP_PASS=smpt pass
JWT_EMAIL_SECRET=email secret key
JWT_REFRESH_SECRET=refresh secret key
JWT_ACCESS_SECRET=access token secret key
JWT_ACCESS_EXPIRY=expiry time for access token
JWT_REFRESH_EXPIRY=expiry time for refresh token
BASE_URL=backend base url
FRONTEND_URL=frontend url
AUTH_CLIENT_ID=client id for google auth
AUTH_CLIENT_SECRET=client secret for google auth
STRIPE_SECRET_KEY=stripe secret key
STRIPE_WEBHOOK_SECRET=stripe webhook secret key
STRIPE_SUBSCRIPTION_CANCEL_URL=subscription cancelled redirect url
STRIPE_SUBSCRIPTION_SUCCESS_URL=subscription success redirect url
MONGO_URI=mongodb cofig url
PORT=port number for server
GOOGLE_CLIENT_ID=google client id
GOOGLE_CLIENT_SECRET=google client secret
REDIS_URL=redis url
ZC_APP_ID=zegocloud app id
ZC_SERVERSECRET=zegocloud secret key